{
  "name": "mock-trade-game",
  "version": "1.0.0",
  "description": "A股简单 · 面向所有玩家的沪深300盲图模拟交易游戏",
  "scripts": {
    "deploy": "gh-pages -d dist -m \"deploy: trading game v1.0.0\"",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build:pwa": "node scripts/build-pwa.cjs",
    "build": "node scripts/build-pwa.cjs --dist",
    "predev": "npm run build:pwa",
    "prestart": "npm run build:pwa",
    "pretest": "npm run build:pwa",
    "predeploy": "npm run build"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
